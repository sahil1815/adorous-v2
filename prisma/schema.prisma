generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model Product {
  id             String            @id @default(uuid())
  slug           String            @unique
  name           String
  category       String
  categoryLabel  String
  tagline        String?
  price          Float
  originalPrice  Float?
  description    String?
  complimentaryItem String?         // Optional packaging / gift e.g. "Adorous Signature Keepsake Box & Velvet Pouch"
  featuredImage  String
  badge          String?
  inStock        Boolean           @default(true)
  stockQty       Int?              // null = unlimited (not tracked); 0 = sold out
  isNewDrop      Boolean           @default(false)
  isGiftPick     Boolean           @default(false)
  isBestseller   Boolean           @default(false)
  featuredRank   Int?
  seoKeywords    String            // Store as comma-separated string
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  details        ProductDetail[]
  piecesIncluded ProductPiece[]
  colorways      ProductColorway[]
  galleryImages  ProductGalleryImage[]
  orderItems     OrderItem[]
}

model ProductDetail {
  id        String  @id @default(uuid())
  text      String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductPiece {
  id        String  @id @default(uuid())
  text      String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductColorway {
  id        String  @id @default(uuid())
  colorId   String
  name      String
  hex       String
  inStock   Boolean @default(true)
  image     String?
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductGalleryImage {
  id        String  @id @default(uuid())
  url       String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id             String      @id @default(uuid())
  orderId        String      @unique // e.g. AF-2026-4102
  status         String      @default("pending") // pending, verified, packaging, handed_to_courier, delivered, cancelled
  courierPartner String?
  consignmentId  String?
  paymentMethod  String      @default("Cash on Delivery")
  subtotal       Float
  shippingFee    Float
  discountAmount Float?
  couponCode     String?
  grandTotal     Float
  internalNotes  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  customer       Customer?
  customerUserId String?
  customerUser   CustomerUser? @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  items          OrderItem[]
}

model Customer {
  id              String  @id @default(uuid())
  orderId         String  @unique
  fullName        String
  phone           String
  email           String?
  address         String
  district        String
  giftNote        String?
  whatsappUpdates Boolean @default(true)

  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model CustomerUser {
  id              String         @id @default(uuid())
  fullName        String
  phone           String?        @unique
  email           String?        @unique
  passwordHash    String
  district        String?
  address         String?
  whatsappUpdates Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  orders          Order[]
  savedAddresses  SavedAddress[]
}

model SavedAddress {
  id             String       @id @default(uuid())
  customerUserId String
  label          String       @default("Home") // Home, Office, Studio
  recipientName  String
  phone          String
  district       String
  address        String
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  customerUser   CustomerUser @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String
  productId      String?
  productName    String
  productImage   String
  price          Float
  quantity       Int
  colorName      String
  colorHex       String
  selectedSize   String?

  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model DraftCheckout {
  id               String   @id @default(uuid())
  sessionId        String   @unique
  customerUserId   String?
  fullName         String?
  phone            String?
  email            String?
  address          String?
  district         String?
  giftNote         String?
  paymentMethod    String?  @default("Cash on Delivery")
  cartItemsJson    String   @default("[]") // JSON string of cart items
  subtotal         Float    @default(0)
  shippingFee      Float    @default(0)
  discountAmount   Float?
  couponCode       String?
  grandTotal       Float    @default(0)
  status           String   @default("abandoned") // abandoned, converted
  convertedOrderId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model DraftSignIn {
  id        String   @id @default(uuid())
  sessionId String   @unique
  type      String   @default("register") // register, signin
  fullName  String?
  phone     String?
  email     String?
  district  String?
  address   String?
  status    String   @default("abandoned") // abandoned, converted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LandingPage {
  id         String   @id @default(uuid())
  slug       String   @unique
  title      String
  headline   String
  subtitle   String?
  productIds String[]
  sortOrder  String   @default("manual")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model WelcomeOfferSettings {
  id                String   @id @default("default")
  enabled           Boolean  @default(true)
  discountPercent   Float    @default(10)
  delaySeconds      Int      @default(5)
  durationMinutes   Int      @default(30)
  maxDiscountAmount Float?   @default(500)
  minOrderAmount    Float?   @default(0)
  welcomeTitle      String   @default("Welcome to Adorous Fashion ✨")
  welcomeSubtext    String   @default("As a special welcome, enjoy an exclusive 10% off on your first order. This offer expires in 30 minutes — start exploring our curated collection now!")
  ctaButtonText     String   @default("Start Shopping Now")
  skipButtonText    String   @default("No thanks, continue browsing")
  timerLabel        String   @default("New Visitor Offer")
  badgeText         String   @default("Exclusive First Visit Offer")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

