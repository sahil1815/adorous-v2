generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id                  String            @id @default(uuid())
  slug                String            @unique
  name                String
  category            String
  categoryLabel       String
  tagline             String?
  price               Float
  originalPrice       Float?
  discount            Float?            // Discount value (e.g. 14 for 14%, or 200 for flat 200 BDT)
  discountType        String?           @default("percent") // "percent" | "flat"
  description         String?           @db.Text
  complimentaryItem   String?
  featuredImage       String            @db.Text
  badge               String?
  inStock             Boolean           @default(true)
  stockQty            Int?              // null = unlimited (not tracked); 0 = sold out
  isNewDrop           Boolean           @default(false)
  isGiftPick          Boolean           @default(false)
  isBestseller        Boolean           @default(false)
  featuredRank        Int?
  seoKeywords         String            @db.Text // Store as comma-separated string
  isHidden            Boolean           @default(false)
  sizes               Json?             @default("[]")
  allowMultipleColors Boolean           @default(true)
  allowMultipleSizes  Boolean           @default(false)
  hasCustomNote       Boolean           @default(false)
  customNotePrompt    String?           @db.Text
  hasSetPricing       Boolean           @default(false)
  setPricingBanner    String?           @db.Text
  setTiers            Json?             @default("[]")
  showSetPriceInButtons Boolean         @default(false)
  actualPricePosition String            @default("top")
  unitPriceHeaderPrompt String?         @db.Text
  hasCustomTrustPolicy Boolean          @default(false)
  trustGuaranteeTitle String?
  trustGuaranteeText  String?           @db.Text
  trustExchangeTitle  String?
  trustExchangeText   String?
  trustDeliveryTitle  String?
  trustDeliveryText   String?
  showTrustGuarantee  Boolean?          @default(true)
  showTrustExchange   Boolean?          @default(true)
  showTrustDelivery   Boolean?          @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  details             ProductDetail[]
  piecesIncluded      ProductPiece[]
  colorways           ProductColorway[]
  galleryImages       ProductGalleryImage[]
  orderItems          OrderItem[]

  @@index([category, isHidden])
  @@index([isHidden, featuredRank])
  @@index([isBestseller, isHidden])
  @@index([isNewDrop, isHidden])
  @@index([createdAt])
}

model ProductDetail {
  id        String  @id @default(uuid())
  text      String  @db.Text
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductPiece {
  id        String  @id @default(uuid())
  text      String  @db.Text
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductColorway {
  id        String  @id @default(uuid())
  colorId   String
  name      String
  hex       String
  inStock   Boolean @default(true)
  image     String? @db.Text
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductGalleryImage {
  id        String  @id @default(uuid())
  url       String  @db.Text
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id                   String        @id @default(uuid())
  orderId              String        @unique // e.g. AF-2026-4102
  status               String        @default("pending") // pending, verified, packaging, handed_to_courier, delivered, cancelled
  courierPartner       String?
  consignmentId        String?
  paymentMethod        String        @default("Cash on Delivery")
  transactionId        String?
  paymentStatus        String        @default("pending") // pending, verified, fake
  onlineDiscountAmount Float?
  codAmount            Float         @default(0)
  subtotal             Float
  shippingFee          Float
  discountAmount       Float?
  couponCode           String?
  grandTotal           Float
  internalNotes        String?       @db.Text
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  customer             Customer?
  customerUserId       String?
  customerUser         CustomerUser? @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  items                OrderItem[]

  @@index([status, createdAt])
  @@index([customerUserId])
  @@index([createdAt])
}

model Customer {
  id              String  @id @default(uuid())
  orderId         String  @unique
  fullName        String
  phone           String
  email           String?
  address         String  @db.Text
  district        String
  giftNote        String? @db.Text
  whatsappUpdates Boolean @default(true)

  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model CustomerUser {
  id              String         @id @default(uuid())
  fullName        String
  phone           String?        @unique
  email           String?        @unique
  passwordHash    String
  district        String?
  address         String?        @db.Text
  whatsappUpdates Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  orders          Order[]
  savedAddresses  SavedAddress[]
}

model SavedAddress {
  id             String       @id @default(uuid())
  customerUserId String
  label          String       @default("Home") // Home, Office, Studio
  recipientName  String
  phone          String
  district       String
  address        String       @db.Text
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  customerUser   CustomerUser @relation(fields: [customerUserId], references: [id], onDelete: Cascade)

  @@index([customerUserId])
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  productId    String?
  productName  String
  productImage String   @db.Text
  price        Float
  quantity     Int
  colorName    String
  colorHex     String
  selectedSize String?
  selectedSet  String?
  customNote   String?  @db.Text

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model DraftCheckout {
  id                   String   @id @default(uuid())
  sessionId            String   @unique
  customerUserId       String?
  fullName             String?
  phone                String?
  email                String?
  address              String?  @db.Text
  district             String?
  giftNote             String?  @db.Text
  paymentMethod        String?  @default("Cash on Delivery")
  transactionId        String?
  onlineDiscountAmount Float?
  cartItemsJson        String   @default("[]") @db.Text
  subtotal             Float    @default(0)
  shippingFee          Float    @default(0)
  discountAmount       Float?
  couponCode           String?
  grandTotal           Float    @default(0)
  status               String   @default("abandoned") // abandoned, converted
  convertedOrderId     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status, updatedAt])
}

model DraftSignIn {
  id        String   @id @default(uuid())
  sessionId String   @unique
  type      String   @default("register") // register, signin
  fullName  String?
  phone     String?
  email     String?
  district  String?
  address   String?  @db.Text
  status    String   @default("abandoned") // abandoned, converted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LandingPage {
  id         String   @id @default(uuid())
  slug       String   @unique
  title      String
  headline   String
  subtitle   String?  @db.Text
  productIds Json?    @default("[]")
  sortOrder  String   @default("manual")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
}

model WelcomeOfferSettings {
  id                String   @id @default("default")
  enabled           Boolean  @default(true)
  offerMode         String   @default("EVERY_VISIT") // "EVERY_VISIT" | "FIRST_VISIT_ONLY"
  discountPercent   Float    @default(10)
  delaySeconds      Int      @default(5)
  durationMinutes   Int      @default(30)
  maxDiscountAmount Float?   @default(500)
  minOrderAmount    Float?   @default(0)
  welcomeTitle      String   @default("Welcome to Adorous Fashion ✨")
  welcomeSubtext    String   @default("As a special welcome, enjoy an exclusive 10% off on your first order. This offer expires in 30 minutes — start exploring our curated collection now!") @db.Text
  ctaButtonText     String   @default("Start Shopping Now")
  skipButtonText    String   @default("No thanks, continue browsing")
  timerLabel        String   @default("New Visitor Offer")
  badgeText         String   @default("Exclusive First Visit Offer")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model LookbookLook {
  id          String   @id @default(uuid())
  numeral     String   @default("LOOK I")
  title       String
  tagline     String
  description String   @db.Text
  heroImage   String   @db.Text
  paletteJson String   @default("[]") @db.Text
  itemIds     Json?    @default("[]") // Array of product IDs or slugs
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LookbookSettings {
  id                  String   @id @default("default")
  pageBadge           String   @default("Curated Still Life Harmonies")
  pageTitle           String   @default("The Atelier Lookbook")
  pageDescription     String   @default("Every ensemble is photographed as a still life study on architectural warm stone plinths, velvet neckforms, and keepsake trays. Discover how our jewelry, bangles, and boutique bags unite into harmonious festival ensembles.") @db.Text
  homepageBadge       String   @default("Editorial Lookbook 2026")
  homepageHeading     String   @default("Designed to dialogue, not compete.") @db.Text
  homepageDescription String   @default("Every piece in the Adorous catalog is calibrated to harmonize. The warm antique gold finish of the Zari Choker mirrors the brass clasps on the Gulshan Bag and the peacock karas on the Meher Bangle stack.") @db.Text
  homepageImage1      String   @default("/images/products/jewelry-zari-choker.jpg") @db.Text
  homepageImage1Label String   @default("Zari Bridal Choker")
  homepageImage2      String   @default("/images/products/churi-meher-emerald.jpg") @db.Text
  homepageImage2Label String   @default("Meher Bangle Stack")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CategoryHeroSettings {
  categorySlug String   @id
  heroImage    String   @db.Text
  productId    String?
  productName  String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model ProductPageOrdering {
  pageKey     String   @id // e.g. 'shop-all', 'category-jewelry', 'category-bags', 'category-churi', 'category-earrings', 'category-more'
  sortOrder   String   @default("manual") // 'manual' | 'most-purchased' | 'newest' | 'oldest' | 'best-rating'
  manualOrder Json?    // string[] of product IDs in exact sequence
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model WhatsAppSettings {
  id                   String   @id @default("default")
  verificationTemplate String   @default("Hello {customer_name}! Greetings from Adorous Fashion.\n\nWe have received your Cash on Delivery order: {order_id}\n\nItems: {items}\n\nTotal Amount: ৳{total_amount}\n\nDelivery Address: {delivery_address}\n\nPlease confirm if this address is correct so we can package and dispatch your order today.") @db.Text
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}

model OrderSequence {
  year    Int @id
  lastSeq Int
}

model PaymentSettings {
  id                   String   @id @default("default")
  enabled              Boolean  @default(true)
  bkashNumber          String   @default("01854411797")
  bkashAccountType     String   @default("Personal (Send Money)")
  nagadNumber          String   @default("01854411797")
  nagadAccountType     String   @default("Personal (Send Money)")
  onlineDiscountAmount Float    @default(50) // Flat X tk discount for paying online
  instructions         String   @default("Please Send Money to our bKash or Nagad Personal number or Payment to Merchant, then enter the Transaction ID below.") @db.Text
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}

model TrustPolicySettings {
  id             String   @id // 'global' | 'jewelry' | 'bags' | 'churi' | 'earrings' | 'more'
  guaranteeTitle String   @default("৬ মাসের গ্যারান্টি (6-Month Official Guarantee)")
  guaranteeText  String   @db.Text
  exchangeTitle  String   @default("৭ দিনের এক্সচেঞ্জ :")
  exchangeText   String   @default("সাইজ ও ফিনিশ পরিবর্তনযোগ্য")
  deliveryTitle  String   @default("ডেলিভারি :")
  deliveryText   String   @default("1–3 days")
  showGuarantee  Boolean  @default(true)
  showExchange   Boolean  @default(true)
  showDelivery   Boolean  @default(true)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}
